{
  "C_Cpp_Runner.cCompilerPath": "clang",
  "C_Cpp_Runner.cppCompilerPath": "clang++",
  "C_Cpp_Runner.debuggerPath": "lldb",
  "C_Cpp_Runner.cStandard": "c99",
  "C_Cpp_Runner.cppStandard": "c++26",
  "C_Cpp_Runner.msvcBatchPath": "",
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.warnings": [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wformat=2",
    "-Wcast-align",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wnull-dereference"
  ],
  "C_Cpp_Runner.msvcWarnings": [
    "/W4",
    "/permissive-",
    "/w14242",
    "/w14287",
    "/w14296",
    "/w14311",
    "/w14826",
    "/w44062",
    "/w44242",
    "/w14905",
    "/w14906",
    "/w14263",
    "/w44265",
    "/w14928"
  ],
  "C_Cpp_Runner.enableWarnings": true,
  "C_Cpp_Runner.warningsAsError": false,
  "C_Cpp_Runner.compilerArgs": [],
  "C_Cpp_Runner.linkerArgs": [],
  "C_Cpp_Runner.includePaths": [],
  "C_Cpp_Runner.includeSearch": [
    ".",
    "src",
    "tools",
    "thirdparty/include"
  ],
  "C_Cpp_Runner.excludeSearch": [
    "**/build",
    "**/build/**",
    "**/.*",
    "**/.*/**",
    "**/.vscode",
    "**/.vscode/**"
  ],
  "C_Cpp_Runner.useAddressSanitizer": false,
  "C_Cpp_Runner.useUndefinedSanitizer": false,
  "C_Cpp_Runner.useLeakSanitizer": false,
  "C_Cpp_Runner.showCompilationTime": false,
  "C_Cpp_Runner.useLinkTimeOptimization": false,
  "C_Cpp_Runner.msvcSecureNoWarnings": false,
  "c-cpp-flylint.clang.includePaths": [
    ".",
    "src",
    "tools",
    "thirdparty/include"
  ],
  "cmake.ignoreCMakeListsMissing": true,
  "C_Cpp.default.cppStandard": "c++26",
  "C_Cpp.default.cStandard": "c99",
  "C_Cpp.default.browse.path": [
    ".",
    "src",
    "tools",
    "thirdparty/include"
  ],
  "C_Cpp.default.recursiveIncludes.order": "breadthFirst",
  "C_Cpp.default.recursiveIncludes.priority": "afterSystemIncludes",
  "C_Cpp.default.recursiveIncludes.reduce": "default",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.doxygen.generatedStyle": "/**",
  "C_Cpp.autoAddFileAssociations": true
}